FROM node:20-alpine AS build
ARG CACHE_BUST=20260521v3
ARG VITE_API_URL
ARG VITE_BANK_ID
ARG VITE_BANK_ACCOUNT
ARG VITE_BANK_ACCOUNT_NAME
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BANK_ID=$VITE_BANK_ID
ENV VITE_BANK_ACCOUNT=$VITE_BANK_ACCOUNT
ENV VITE_BANK_ACCOUNT_NAME=$VITE_BANK_ACCOUNT_NAME
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 443
