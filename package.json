{
  "name": "aduu",
  "version": "1.0.0",
  "description": "Aduu - Hệ thống hoạch định nguồn lực doanh nghiệp v.2.0",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node prisma/startup.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "node prisma/seed.js && node prisma/seed_accounting.js && node prisma/seed_accounting_demo.js",
    "db:seed:accounting-demo": "node prisma/seed_accounting_demo.js",
    "db:seed:accounting": "node prisma/seed_accounting.js",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "test": "jest --runInBand",
    "check:modules": "node scripts/check-module-load.js",
    "check:llm": "node scripts/check-llm.js",
    "check:humangate": "node scripts/check-humangate.js",
    "check:tenant": "node scripts/check-tenant-isolation.js && node scripts/check-tenant-gaps.js && node scripts/check-tenant-null.js",
    "check:tenant:null": "node scripts/check-tenant-null.js",
    "tenant:null": "node scripts/tenant-null.js",
    "smoke:humangate": "node scripts/smoke-humangate.js",
    "smoke:po-gate": "node scripts/smoke-po-gate.js",
    "db:shadow": "node scripts/ensure-shadow-db.js",
    "smoke:crm-pipeline": "node scripts/smoke-crm-pipeline.js",
    "smoke:crm-phase2": "node scripts/smoke-crm-phase2.js",
    "smoke:crm-phase4-campaign": "node scripts/smoke-crm-phase4-campaign.js",
    "smoke:crm-phase4-send": "node scripts/smoke-crm-phase4-send.js",
    "smoke:crm-phase4-hierarchy": "node scripts/smoke-crm-phase4-hierarchy.js",
    "smoke:crm-phase4-insights": "node scripts/smoke-crm-phase4-insights.js",
    "smoke:crm-phase4": "npm run smoke:crm-phase4-send && npm run smoke:crm-phase4-campaign && npm run smoke:crm-phase4-hierarchy && npm run smoke:crm-phase4-insights",
    "check:i18n": "node scripts/check-i18n-keys.js",
    "verify": "node scripts/verify.js",
    "verify:quick": "node scripts/verify.js --quick",
    "check:swagger": "node scripts/check-swagger-yaml.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "@faker-js/faker": "^10.4.0",
    "@payos/node": "^2.0.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.53.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "ai": "^6.0.193",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "exceljs": "^3.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.34.0",
    "otplib": "^13.4.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "pm2": "^7.0.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.6.0",
    "nodemon": "^3.1.0",
    "prisma": "^7.8.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "fast-csv": "5.0.2",
    "tmp": "0.2.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
