map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 20m;
    resolver ${DNS_RESOLVER} valid=10s;
    set $backend http://${BACKEND_HOST}:${BACKEND_PORT};

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Railway terminates HTTPS at its edge; internal traffic is HTTP.
    location /api/ {
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Railway supplies the client address. Overwrite the chain so Express
        # trust proxy=1 sees the edge-provided address rather than this proxy.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /socket.io/ {
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location / {
        add_header Cache-Control no-cache;
        try_files $uri $uri/ /index.html;
    }

    location ~ /\. { deny all; }
}
