enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  CATEGORY_DISCOUNT
  PRODUCT_DISCOUNT
  FREE_SHIPPING
}

enum PromotionScope {
