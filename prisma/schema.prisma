// ==================== BANK ACCOUNTS ====================

enum BankTxType {
  DEPOSIT // Nộp tiền
  WITHDRAW // Rút tiền
  TRANSFER_IN // Nhận chuyển khoản
  TRANSFER_OUT // Chuyển khoản đi
  FEE // Phí ngân hàng
  INTEREST // Lãi
}

model BankAccount {
  id             String   @id @default(uuid())
  accountNumber  String   @unique
  bankName       String
  accountName    String
  accountId      String // FK tới Account.id (loại 112)
  openingBalance Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance Decimal  @default(0) @db.Decimal(15, 2)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions BankTransaction[]
  expensesPaid Expense[]         @relation("ExpensePaidFrom")
  statements   BankStatement[]

  @@map("bank_accounts")
}

model BankTransaction {
  id            String      @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime    @default(now())
  type          BankTxType
  amount        Decimal     @db.Decimal(15, 2)
  balanceAfter  Decimal     @db.Decimal(15, 2)
  reference     String? // mã giao dịch ngân hàng
  description   String
  createdById   String?
  createdBy     User?       @relation("BankTxCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([bankAccountId, date])
  @@map("bank_transactions")
}

// ==================== FISCAL PERIOD ====================

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FiscalPeriod {
  id         String             @id @default(uuid())
  year       Int
  month      Int // 1..12; 0 = năm
  startDate  DateTime
  endDate    DateTime
  status     FiscalPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  closedBy   User?              @relation("PeriodClosedBy", fields: [closedById], references: [id])
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  entries JournalEntry[]

  @@unique([year, month])
  @@map("fiscal_periods")
}

// ==================== DEBT ====================

enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  OPEN
  PARTIAL
  CLOSED
  OVERDUE
}

model Debt {
  id         String     @id @default(uuid())
  type       DebtType
  status     DebtStatus @default(OPEN)
  amount     Decimal    @db.Decimal(12, 2)
  paidAmount Decimal    @default(0) @db.Decimal(12, 2)
  dueDate    DateTime?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  vendorId      String?
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  orderId       String?        @unique
  order         Order?         @relation(fields: [orderId], references: [id])
  poId          String?        @unique
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])

  payments DebtPayment[]

  @@index([status, dueDate])
  @@map("debts")
}

model DebtPayment {
  id          String        @id @default(uuid())
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  note        String?
  paidAt      DateTime      @default(now())
  debtId      String
  debt        Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@map("debt_payments")
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  ORDER_PENDING_LONG
  PO_PENDING_APPROVAL
  DEBT_OVERDUE
  PAYROLL_DUE
  EXPENSE_PENDING_APPROVAL
  PERIOD_CLOSING_REMINDER
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String               @id @default(uuid())
  type      NotificationType
  severity  NotificationSeverity @default(INFO)
  title     String
  message   String
  link      String?
  meta      Json?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleScope Role?

  @@index([userId, isRead])
  @@index([roleScope, isRead])
  humanGateId    String?
  requiresAction Boolean  @default(false)

  @@index([type, createdAt(sort: Desc)])
  @@map("notifications")
}

// ==================== PROJECT MANAGEMENT ====================

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

model Project {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(15, 2)

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  tasks           ProjectTask[]
  members         ProjectMember[]
  expenses        Expense[]        @relation("ProjectExpenses")
  timeEntries     TimeEntry[]
  projectInvoices ProjectInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
  @@map("projects")
}

model ProjectTask {
  id            String              @id @default(uuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        ProjectTaskStatus   @default(TODO)
  priority      ProjectTaskPriority @default(MEDIUM)
  dueDate       DateTime?
  estimateHours Decimal?            @db.Decimal(8, 2)
  actualHours   Decimal             @default(0) @db.Decimal(8, 2)
  dependsOnId   String?
  dependsOn     ProjectTask?        @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents    ProjectTask[]       @relation("TaskDependency")

  assigneeId String?
  assignee   User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id])

  createdById String
  createdBy   User   @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id])

  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@map("project_tasks")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("ProjectMemberships", fields: [userId], references: [id])
  role      ProjectMemberRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

// ==================== PRODUCTION MANAGEMENT ====================

enum BomStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Bom {
  id            String    @id @default(uuid())
  code          String    @unique
  productId     String
  product       Product   @relation("BomProduct", fields: [productId], references: [id])
  version       String    @default("v1")
  status        BomStatus @default(DRAFT)
  isSubAssembly Boolean   @default(false)
  parentBomId   String?
  parentBom     Bom?      @relation("BomParent", fields: [parentBomId], references: [id])
  childBoms     Bom[]     @relation("BomParent")
  notes         String?

  items      BomItem[]
  workOrders WorkOrder[]
  routings   Routing[]

  createdById String
  createdBy   User   @relation("BomCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@map("boms")
}

model BomItem {
  id          String  @id @default(uuid())
  bomId       String
  bom         Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("BomComponent", fields: [componentId], references: [id])
  quantity    Int
  notes       String?

  createdAt DateTime @default(now())

  @@unique([bomId, componentId])
  @@map("bom_items")
}

model WorkOrder {
  id        String  @id @default(uuid())
  code      String  @unique
  bomId     String
  bom       Bom     @relation(fields: [bomId], references: [id])
  productId String
  product   Product @relation("WorkOrderProduct", fields: [productId], references: [id])

  quantity    Int
  producedQty Int @default(0)

  // Tổng giá vốn nguyên liệu tại thời điểm complete (đơn vị: VND)
  totalCost      Decimal? @db.Decimal(15, 2)
  // Tham chiếu tới bút toán kế toán khi complete
  journalEntryId String?

  status WorkOrderStatus @default(DRAFT)

  warehouseId String
  warehouse   Warehouse @relation("WorkOrderWarehouse", fields: [warehouseId], references: [id])

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  notes String?

  routingId String?
  routing   Routing? @relation(fields: [routingId], references: [id])

  items         WorkOrderItem[]
  qualityChecks QualityCheck[]
  lotTxs        LotTransaction[]

  createdById String
  createdBy   User   @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([productId])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  componentId String
  component   Product   @relation("WorkOrderComponent", fields: [componentId], references: [id])

  requiredQty Int
  consumedQty Int @default(0)

  createdAt DateTime @default(now())

  @@unique([workOrderId, componentId])
  @@map("work_order_items")
}

// ==================== WORK CENTER & ROUTING ====================

model WorkCenter {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  capacity    Decimal  @default(8) @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operations RoutingOperation[]

  @@map("work_centers")
}

model Routing {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bomId     String?
  bom       Bom?     @relation(fields: [bomId], references: [id])
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations RoutingOperation[]
  workOrders WorkOrder[]

  @@map("routings")
}

model RoutingOperation {
  id              String      @id @default(uuid())
  routingId       String
  routing         Routing     @relation(fields: [routingId], references: [id], onDelete: Cascade)
  sequence        Int
  name            String
  workCenterId    String?
  workCenter      WorkCenter? @relation(fields: [workCenterId], references: [id])
  durationMinutes Int         @default(60)
  notes           String?
  createdAt       DateTime    @default(now())

  @@map("routing_operations")
}

model QualityCheck {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING")
  checkedById String?
  checkedBy   User?     @relation("QCCheckedBy", fields: [checkedById], references: [id])
  checkedAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items QualityCheckItem[]

  @@map("quality_checks")
}

model QualityCheckItem {
  id             String       @id @default(uuid())
  qualityCheckId String
  qualityCheck   QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)
  name           String
  result         String?
  notes          String?
  createdAt      DateTime     @default(now())

  @@map("quality_check_items")
}

// ==================== LOT / SERIAL TRACKING ====================

model InventoryLot {
  id          String    @id @default(uuid())
  lotCode     String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int       @default(0)
  originalQty Int       @default(0)
  mfgDate     DateTime? @db.Date
  expDate     DateTime? @db.Date
  poId        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions LotTransaction[]

  @@unique([lotCode, productId, warehouseId])
  @@index([productId])
  @@index([expDate])
  @@map("inventory_lots")
}

model LotTransaction {
  id          String       @id @default(uuid())
  lotId       String
  lot         InventoryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  txId        String?
  orderId     String?
  workOrderId String?
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id])
  quantity    Int
  type        String
  createdAt   DateTime     @default(now())

  @@map("lot_transactions")
}

// ==================== SERIAL NUMBER TRACKING ====================

model SerialNumber {
  id          String   @id @default(uuid())
  serialCode  String
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      String   @default("IN_STOCK") // IN_STOCK | SOLD | RETURNED | DAMAGED
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serialCode, productId])
  @@index([productId, status])
  @@index([warehouseId])
  @@map("serial_numbers")
}

// ==================== MARKETPLACE ====================

model MarketplaceShop {
  id          String    @id @default(uuid())
  platform    String
  shopName    String?
  shopId      String?
  isActive    Boolean   @default(true)
  credentials Json?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listings MarketplaceListing[]
  syncLogs MarketplaceSyncLog[]

  @@map("marketplace_shops")
}

model MarketplaceListing {
  id           String          @id @default(uuid())
  shopId       String
  shop         MarketplaceShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform     String
  externalId   String?
  externalSku  String?
  status       String          @default("ACTIVE")
  lastPushedAt DateTime?
  syncErrors   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([shopId, productId])
  @@map("marketplace_listings")
}

model MarketplaceSyncLog {
  id        String          @id @default(uuid())
  shopId    String
  shop      MarketplaceShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  direction String
  entity    String
  status    String
  count     Int             @default(0)
  errors    Json?
  startedAt DateTime        @default(now())
  endedAt   DateTime?

  @@map("marketplace_sync_logs")
}

// ==================== TIME TRACKING & PROJECT INVOICING ====================

model TimeEntry {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        ProjectTask?    @relation(fields: [taskId], references: [id])
  userId      String
  user        User            @relation("TimeEntryUser", fields: [userId], references: [id])
  startTime   DateTime
  endTime     DateTime?
  hours       Decimal?        @db.Decimal(8, 2)
  description String?
  billable    Boolean         @default(true)
  hourlyRate  Decimal         @default(0) @db.Decimal(12, 2)
  invoiced    Boolean         @default(false)
  invoiceId   String?
  invoice     ProjectInvoice? @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("time_entries")
}

model ProjectInvoice {
  id          String    @id @default(uuid())
  invoiceCode String    @unique
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  amount      Decimal   @db.Decimal(15, 2)
  status      String    @default("DRAFT")
  issuedAt    DateTime?
  dueDate     DateTime? @db.Date
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timeEntries TimeEntry[]

  @@index([projectId])
  @@map("project_invoices")
}

// ==================== PHASE 4: REPORT BUILDER ====================

model SavedReport {
  id          String   @id @default(uuid())
  name        String
  description String?
  config      Json
  isPublic    Boolean  @default(false)
  createdById String
  createdBy   User     @relation("ReportCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules ReportSchedule[]

  @@map("saved_reports")
}

model ReportSchedule {
  id        String      @id @default(uuid())
  reportId  String
  report    SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cron      String
  emailTo   String[]
  lastRunAt DateTime?
  nextRunAt DateTime?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@map("report_schedules")
}

// ==================== PHASE 4: WORKFLOW ENGINE ====================

model Workflow {
  id          String   @id @default(uuid())
  name        String
  trigger     String
  config      Json     @default("{}")
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps WorkflowStep[]
  runs  WorkflowRun[]

  @@map("workflows")
}

model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sequence   Int
  type       String
  config     Json     @default("{}")
  createdAt  DateTime @default(now())

  approvals WorkflowApproval[]

  @@map("workflow_steps")
}

model WorkflowRun {
  id         String    @id @default(uuid())
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  entity     String
  entityId   String
  status     String    @default("PENDING")
  data       Json?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  approvals WorkflowApproval[]

  @@map("workflow_runs")
}

model WorkflowApproval {
  id         String       @id @default(uuid())
  runId      String
  run        WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId     String
  step       WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approverId String
  approver   User         @relation("WorkflowApprover", fields: [approverId], references: [id])
  status     String       @default("PENDING")
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@map("workflow_approvals")
}

// ==================== PHASE 4: CUSTOMER PORTAL ====================

model PortalSession {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("portal_sessions")
}

model PortalOtp {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("portal_otps")
}

// ==================== INTEGRATION CONFIG ====================

model IntegrationConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  category  String
  valueEnc  String?
  iv        String?
  isSecret  Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
  @@map("integration_configs")
}

// ==================== PHASE 4: CAMPAIGN TRACKING ====================

model CampaignTracking {
  id          String    @id @default(uuid())
  campaignId  String
  recipientId String?
  recipient   Customer? @relation(fields: [recipientId], references: [id])
  event       String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([campaignId])
  @@map("campaign_trackings")
}

// ==================== AGENT LAYER (v3.0) ====================

enum AgentSessionStatus {
  RUNNING
  WAITING_HUMAN
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStepType {
  LLM_CALL
  TOOL_CALL
  HUMAN_GATE
  RENDER_UI
}

enum HumanGateStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model AgentSession {
  id              String             @id @default(uuid())
  sessionCode     String             @unique @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String?
  status          AgentSessionStatus @default(RUNNING)
  intent          String?
  triggerSource   String             @default("USER_CHAT") // USER_CHAT | CRON_JOB | SYSTEM_EVENT
  userMessage     String             @db.Text
  contextSnapshot Json?
  finalResult     Json?
  errorMsg        String?
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  createdAt       DateTime           @default(now())
  steps           AgentStep[]
  humanGates      AgentHumanGate[]
  feedback        AgentFeedback[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([triggerSource])
  @@map("agent_sessions")
}

model AgentStep {
  id          String        @id @default(uuid())
  sessionId   String
  session     AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence    Int
  type        AgentStepType
  toolName    String?
  toolInput   Json?
  toolOutput  Json?
  prompt      String?       @db.Text
  completion  String?       @db.Text
  status      String        @default("PENDING")
  durationMs  Int?
  path        String?       // "fast_path" | "fallback_llm"
  confidence  Float?
  errorMsg    String?
  createdAt   DateTime      @default(now())

  @@index([sessionId, sequence])
  @@map("agent_steps")
}

model AgentHumanGate {
  id            String          @id @default(uuid())
  sessionId     String
  session       AgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actionType    String
  actionPayload Json
  actionSummary String          @db.Text
  triggerRule   String?
  status        HumanGateStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?           @relation("HumanGateDecider", fields: [decidedById], references: [id])
  decisionNote  String?
  decidedAt     DateTime?
  expiresAt     DateTime
  createdAt     DateTime        @default(now())

  @@index([sessionId])
  @@index([status, expiresAt])
  @@map("agent_human_gates")
}

model AgentFeedback {
  id          String   @id @default(uuid())
  sessionId   String
  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepId      String?
  userId      String
  user        User     @relation("AgentFeedbackUser", fields: [userId], references: [id])
  query       String   @db.Text
  response    String   @db.Text
  rating      Boolean  // true = thumb up, false = thumb down
  comment     String?
  path        String?  // "fast_path" | "fallback_llm"
  intent      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("agent_feedback")
}

