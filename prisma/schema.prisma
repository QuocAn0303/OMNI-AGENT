// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== USERS & AUTH ====================

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  WAREHOUSE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(CASHIER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  orders                Order[]
  inventoryTransactions InventoryTransaction[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  employee              Employee?
  payments              Payment[]              @relation("PaymentCreatedBy")
  returnsCreated        OrderReturn[]          @relation("ReturnCreatedBy")
  returnsApproved       OrderReturn[]          @relation("ReturnApprovedBy")
  cycleCounts           CycleCount[]           @relation("CycleCountCreatedBy")
  journalEntries        JournalEntry[]         @relation("JournalCreatedBy")
  expenses              Expense[]              @relation("ExpenseCreatedBy")
  expensesApproved      Expense[]              @relation("ExpenseApprovedBy")
  purchaseOrders        PurchaseOrder[]        @relation("PurchaseCreatedBy")
  bankTxs               BankTransaction[]      @relation("BankTxCreatedBy")
  closedPeriods         FiscalPeriod[]         @relation("PeriodClosedBy")
  purchaseOrdersApproved PurchaseOrder[]       @relation("PurchaseApprovedBy")
  debtPayments          DebtPayment[]
  notifications         Notification[]
  customerNotes         CustomerNote[]
  tasksAssigned         CustomerTask[]         @relation("TaskAssignedTo")
  tasksCreated          CustomerTask[]         @relation("TaskCreatedBy")
  segmentsCreated       CustomerSegment[]
  campaignsCreated      CustomerCampaign[]

  projectsCreated      Project[]       @relation("ProjectCreatedBy")
  projectMemberships   ProjectMember[] @relation("ProjectMemberships")
  projectTasksAssigned ProjectTask[]   @relation("ProjectTaskAssignee")
  projectTasksCreated  ProjectTask[]   @relation("ProjectTaskCreatedBy")

  bomsCreated       Bom[]       @relation("BomCreatedBy")
  workOrdersCreated WorkOrder[] @relation("WorkOrderCreatedBy")

  @@index([tenantId])
  @@map("users")
}

// ==================== COMPANY SETTINGS ====================

model CompanySettings {
  id             String   @id @default(uuid())
  name           String   @default("Công ty của tôi")
  address        String?
  phone          String?
  email          String?
  taxCode        String?
  logo           String?
  industry       String?
  currency       String   @default("VND")
  onboardingDone Boolean  @default(false)
  onboardingStep Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("company_settings")
}

// ==================== PRODUCTS ====================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  promotions Promotion[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  imageUrl    String?
  description String?
  price       Decimal  @db.Decimal(12, 2)
  costPrice   Decimal  @db.Decimal(12, 2)
  unit        String   @default("cái")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  inventories     Inventory[]
  orderItems      OrderItem[]
  stockTransferItems StockTransferItem[]
  cycleCountItems CycleCountItem[]
  purchaseItems   PurchaseItem[]
  promotions      Promotion[]
  exchangeItems   ExchangeItem[]

  bomsAsProduct             Bom[]           @relation("BomProduct")
  bomItemsAsComponent       BomItem[]       @relation("BomComponent")
  workOrdersAsProduct       WorkOrder[]     @relation("WorkOrderProduct")
  workOrderItemsAsComponent WorkOrderItem[] @relation("WorkOrderComponent")

  @@index([name])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// ==================== INVENTORY & WAREHOUSES ====================

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  inventories    Inventory[]
  orders         Order[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  workOrders     WorkOrder[]     @relation("WorkOrderWarehouse")

  @@map("warehouses")
}

model Inventory {
  id        String   @id @default(uuid())
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  minStock  Int      @default(10)
  updatedAt DateTime @updatedAt

  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  transactions InventoryTransaction[]

  @@unique([productId, warehouseId])
  @@map("inventories")
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String              @id @default(uuid())
  transferCode    String              @unique
  status          StockTransferStatus @default(PENDING)
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  note            String?
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  items           StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int

  @@map("stock_transfer_items")
}

enum TransactionType {
  IMPORT
  EXPORT
  ADJUSTMENT
  RETURN
  RESERVATION
  RESERVATION_RELEASE
}

model InventoryTransaction {
  id        String          @id @default(uuid())
  type      TransactionType
  quantity  Int
  note      String?
  createdAt DateTime        @default(now())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("inventory_transactions")
}

// ==================== CUSTOMERS ====================

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum CustomerNoteType {
  NOTE
  CALL
  EMAIL
  MEETING
  ZALO
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String?  @unique
  email      String?
  address    String?
  totalSpent    Decimal  @default(0) @db.Decimal(12, 2)
  totalDebt     Decimal  @default(0) @db.Decimal(12, 2)
  storeCredit   Decimal  @default(0) @db.Decimal(12, 2)
  tier          CustomerTier @default(BRONZE)
  loyaltyPoints Int          @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders          Order[]
  debts           Debt[]
  promotionUsages PromotionUsage[]
  loyaltyTxs      LoyaltyTransaction[]
  notes           CustomerNote[]
  tags            CustomerTagOnCustomer[]
  tasks           CustomerTask[]
  campaignRecipients CampaignRecipient[]

  @@index([name])
  @@index([phone])
  @@index([email])
  @@map("customers")
}

model CustomerNote {
  id          String           @id @default(uuid())
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content     String           @db.Text
  type        CustomerNoteType @default(NOTE)
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

model CustomerTag {
  id        String                   @id @default(uuid())
  name      String                   @unique
  color     String                   @default("#0f766e")
  createdAt DateTime                 @default(now())
  customers CustomerTagOnCustomer[]

  @@map("customer_tags")
}

model CustomerTagOnCustomer {
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@id([customerId, tagId])
  @@map("customer_tag_on_customer")
}

model CustomerTask {
  id           String       @id @default(uuid())
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(NORMAL)
  dueAt        DateTime?
  assignedToId String
  assignedTo   User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([customerId])
  @@map("customer_tasks")
}

model CustomerSegment {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  rules         Json
  customerCount Int      @default(0)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns     CustomerCampaign[]

  @@map("customer_segments")
}

enum CampaignChannel {
  EMAIL
  ZALO
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model CustomerCampaign {
  id           String          @id @default(uuid())
  name         String
  channel      CampaignChannel
  segmentId    String
  segment      CustomerSegment @relation(fields: [segmentId], references: [id])
  subject      String?
  bodyTemplate String          @db.Text
  status       CampaignStatus  @default(DRAFT)
  scheduledAt  DateTime?
  sentAt       DateTime?
  stats        Json?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  recipients   CampaignRecipient[]

  @@index([status, scheduledAt])
  @@map("customer_campaigns")
}

model CampaignRecipient {
  id         String           @id @default(uuid())
  campaignId String
  campaign   CustomerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id])
  status     RecipientStatus  @default(PENDING)
  error      String?
  sentAt     DateTime?

  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model LoyaltyTransaction {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  points     Int
  type       String
  orderId    String?
  note       String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("loyalty_transactions")
}

// ==================== ORDERS ====================

enum OrderStatus {
  PENDING // chờ xử lý
  CONFIRMED // xác nhận
  SHIPPING // đang giao
  COMPLETED // hoàn thành
  CANCELLED // hủy
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundMethod {
  CASH
  BANK_TRANSFER
  STORE_CREDIT
  EXCHANGE
  NONE
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  CUSTOMER_CHANGE
  EXPIRED
  OTHER
}

model Order {
  id            String        @id @default(uuid())
  orderCode     String        @unique
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  discountType       String?       @default("NONE")
  discountValue      Decimal       @default(0) @db.Decimal(12, 2)
  promotionDiscount  Decimal       @default(0) @db.Decimal(12, 2)
  voucherCode        String?
  loyaltyDiscount    Decimal       @default(0) @db.Decimal(12, 2)
  loyaltyPointsUsed  Int           @default(0)
  total              Decimal       @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items    OrderItem[]
  payments Payment[]
  returns          OrderReturn[]
  debt             Debt?
  promotionUsages  PromotionUsage[]
  invoice          Invoice?
  delivery         Delivery?

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model Invoice {
  id          String   @id @default(uuid())
  invoiceCode String   @unique
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  pdfUrl      String?
  taxCode     String?
  companyName String?
  emailSentAt DateTime?
  createdAt   DateTime @default(now())

  @@map("invoices")
}

enum DeliveryProvider {
  GHTK
  GHN
  VNPOST
  VIETTEL_POST
  J_T
  SELF
  OTHER
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

model Delivery {
  id               String           @id @default(uuid())
  orderId          String           @unique
  order            Order            @relation(fields: [orderId], references: [id])
  provider         DeliveryProvider
  trackingCode     String?
  shippingFee      Decimal          @default(0) @db.Decimal(12, 2)
  status           DeliveryStatus   @default(PENDING)
  recipientName    String
  recipientPhone   String
  recipientAddress String
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  failedReason     String?
  note             String?
  events           DeliveryEvent[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("deliveries")
}

model DeliveryEvent {
  id         String         @id @default(uuid())
  deliveryId String
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     DeliveryStatus
  location   String?
  note       String?
  occurredAt DateTime
  createdAt  DateTime       @default(now())

  @@map("delivery_events")
}

model OrderItem {
  id             String  @id @default(uuid())
  quantity       Int
  price          Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  discountType   String? @default("NONE")
  discountValue  Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  returnItems OrderReturnItem[]

  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  note        String?
  createdById String
  createdBy   User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@map("payments")
}

model OrderReturn {
  id           String            @id @default(uuid())
  returnCode   String            @unique
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id])
  status       ReturnStatus      @default(PENDING)
  reason       ReturnReason
  restockable  Boolean           @default(true)
  refundMethod RefundMethod      @default(CASH)
  refundAmount Decimal           @db.Decimal(12, 2)
  completedAt  DateTime?
  note         String?
  createdById  String
  createdBy    User              @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?             @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        OrderReturnItem[]
  exchangeItems ExchangeItem[]

  @@map("order_returns")
}

model ExchangeItem {
  id        String      @id @default(uuid())
  quantity  Int
  unitPrice Decimal     @db.Decimal(12, 2)
  subtotal  Decimal     @db.Decimal(12, 2)
  returnId  String
  return    OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])

  @@map("exchange_items")
}

model OrderReturnItem {
  id           String      @id @default(uuid())
  returnId     String
  return       OrderReturn @relation(fields: [returnId], references: [id])
  orderItemId  String
  orderItem    OrderItem   @relation(fields: [orderItemId], references: [id])
  quantity     Int
  refundAmount Decimal     @db.Decimal(12, 2)

  @@map("order_return_items")
}

// ==================== PROMOTIONS ====================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  CATEGORY_DISCOUNT
  PRODUCT_DISCOUNT
  FREE_SHIPPING
}

enum PromotionScope {
  AUTO
  VOUCHER_CODE
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

model Promotion {
  id            String           @id @default(uuid())
  code          String?          @unique
  name          String
  description   String?
  type          PromotionType
  scope         PromotionScope   @default(AUTO)
  status        PromotionStatus  @default(DRAFT)
  value         Decimal          @db.Decimal(12, 2)
  maxDiscount   Decimal?         @db.Decimal(12, 2)
  minOrderValue Decimal?         @db.Decimal(12, 2)
  minQuantity   Int?
  buyQuantity   Int?
  getQuantity   Int?
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usageCount    Int              @default(0)
  perUserLimit  Int?
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  usages        PromotionUsage[]

  @@index([status, startDate, endDate])
  @@map("promotions")
}

model PromotionUsage {
  id            String    @id @default(uuid())
  discountValue Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  promotionId   String
  promotion     Promotion @relation(fields: [promotionId], references: [id])
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  @@map("promotion_usages")
}

enum CycleCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CycleCount {
  id          String           @id @default(uuid())
  code        String           @unique
  status      CycleCountStatus @default(DRAFT)
  note        String?
  createdById String
  createdBy   User             @relation("CycleCountCreatedBy", fields: [createdById], references: [id])
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CycleCountItem[]

  @@map("cycle_counts")
}

model CycleCountItem {
  id             String     @id @default(uuid())
  cycleCountId   String
  cycleCount     CycleCount @relation(fields: [cycleCountId], references: [id])
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  systemQuantity Int
  actualQuantity Int?
  variance       Int?
  note           String?

  @@map("cycle_count_items")
}

// Lưu refresh token để support refresh / logout
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// Audit log / activity trail
model AuditLog {
  id         String   @id @default(uuid())
  userId     String? // có thể null cho hệ thống
  action     String // ví dụ: CREATE_ORDER, UPDATE_PRODUCT
  entity     String // ví dụ: Order, Product, Inventory
  entityId   String? // id của entity liên quan
  beforeJson Json? // trạng thái trước khi thay đổi
  afterJson  Json? // trạng thái sau khi thay đổi
  meta       Json? // thông tin bổ sung (ip, note ...)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ==================== HR / PAYROLL ====================

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum ViolationType {
  LATE
  EARLY
  PACKING_ERROR
  DAMAGED_GOODS
  UNAUTHORIZED_ABSENCE
}

model Employee {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  employeeCode String?   @unique
  phone        String?
  position     String    @default("OTHER")
  hireDate     DateTime?
  address      String?
  baseSalary   Decimal   @default(5000000) @db.Decimal(12, 2)
  shiftMoney   Decimal   @default(0) @db.Decimal(12, 2)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shifts     Shift[]
  violations Violation[]
  payrolls   Payroll[]

  @@map("employees")
}

model Shift {
  id         String    @id @default(uuid())
  date       DateTime
  type       ShiftType
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())

  @@map("shifts")
}

model Violation {
  id         String        @id @default(uuid())
  type       ViolationType
  note       String?
  penalty    Decimal?      @default(0) @db.Decimal(12, 2)
  date       DateTime      @default(now())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  createdAt  DateTime      @default(now())

  @@map("violations")
}

model Payroll {
  id                    String   @id @default(uuid())
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id])
  month                 Int
  year                  Int
  baseSalary            Decimal  @db.Decimal(12, 2)
  shiftMoney            Decimal  @default(0) @db.Decimal(12, 2)
  shiftCount            Int
  attendanceCoefficient Float
  penalties             Decimal  @db.Decimal(12, 2)
  finalSalary           Decimal  @db.Decimal(12, 2)
  isLocked              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("payrolls")
}

// ==================== ACCOUNTING ====================

enum AccountType {
  ASSET // Tài sản
  LIABILITY // Nợ phải trả
  EQUITY // Vốn chủ sở hữu
  REVENUE // Doanh thu
  EXPENSE // Chi phí
  COST_OF_GOODS_SOLD // Giá vốn hàng bán
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// Hệ thống tài khoản (Chart of Accounts) theo VAS rút gọn
model Account {
  id            String        @id @default(uuid())
  code          String        @unique // 111, 131, 511, 632...
  name          String
  nameVi        String // Tên thân thiện cho founder
  type          AccountType
  normalBalance NormalBalance
  parentId      String?
  parent        Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[]     @relation("AccountTree")
  description   String?
  isCash        Boolean       @default(false) // dùng để tính cash flow
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines             JournalLine[]
  expenseCategories ExpenseCategory[]

  @@index([type])
  @@map("accounts")
}

enum JournalSource {
  MANUAL
  ORDER
  PAYMENT
  RETURN
  PURCHASE
  EXPENSE
  PAYROLL
  INVENTORY
  BANK
  ADJUSTMENT
  OPENING_BALANCE
  DEBT
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id             String         @id @default(uuid())
  entryCode      String         @unique // JE-YYYYMMDD-XXXX
  date           DateTime       @default(now())
  source         JournalSource  @default(MANUAL)
  sourceId       String? // id của Order/Payment/Expense...
  description    String
  status         JournalStatus  @default(POSTED)
  reversedById   String?
  reversedBy     JournalEntry?  @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals      JournalEntry[] @relation("JournalReversal")
  createdById    String?
  createdBy      User?          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          JournalLine[]

  @@index([source, sourceId])
  @@index([date])
  @@map("journal_entries")
}

// Outbox: khi auto-post bút toán thất bại (CoA missing, period closed,
// entryCode collision, ...), thay vì nuốt lỗi và để kế toán lệch, chúng ta
// lưu lại payload + lỗi để retry sau (cron hoặc admin trigger).
model JournalPostingError {
  id          String        @id @default(uuid())
  source      JournalSource
  sourceId    String?
  payload     Json          // input đã chuẩn bị cho postEntry
  errorMsg    String
  retryCount  Int           @default(0)
  lastTriedAt DateTime?
  resolvedAt  DateTime?     // null = chưa xử lý; có giá trị = đã retry thành công hoặc admin đánh dấu bỏ qua
  resolvedEntryId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([source, sourceId])
  @@index([resolvedAt])
  @@map("journal_posting_errors")
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Decimal      @default(0) @db.Decimal(15, 2)
  credit      Decimal      @default(0) @db.Decimal(15, 2)
  description String?
  // tham chiếu phụ (optional) để filter sub-ledger
  partyType   String? // "CUSTOMER" | "VENDOR" | "EMPLOYEE"
  partyId     String?

  @@index([accountId])
  @@index([entryId])
  @@index([partyType, partyId])
  @@map("journal_lines")
}

// ==================== VENDORS / SUPPLIERS ====================

model Vendor {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  taxCode       String? // MST
  phone         String?
  email         String?
  address       String?
  contactPerson String?
  paymentTerms  Int      @default(30) // số ngày công nợ
  totalDebt     Decimal  @default(0) @db.Decimal(15, 2) // tổng còn nợ
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  debts          Debt[]

  @@map("vendors")
}

// ==================== EXPENSES ====================

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  accountId   String // tài khoản chi phí (642, 641, 627...)
  account     Account  @relation(fields: [accountId], references: [id])
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String          @id @default(uuid())
  expenseCode   String          @unique // EXP-YYYYMMDD-XXXX
  date          DateTime        @default(now())
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendorId      String?
  vendor        Vendor?         @relation(fields: [vendorId], references: [id])
  projectId     String?
  project       Project?        @relation("ProjectExpenses", fields: [projectId], references: [id])
  description   String
  amount        Decimal         @db.Decimal(15, 2) // số tiền chưa thuế
  taxRateId     String?
  taxRate       TaxRate?        @relation(fields: [taxRateId], references: [id])
  taxAmount     Decimal         @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal         @db.Decimal(15, 2)
  paymentMethod PaymentMethod   @default(CASH)
  bankAccountId String?
  bankAccount   BankAccount?    @relation("ExpensePaidFrom", fields: [bankAccountId], references: [id])
  status        ExpenseStatus   @default(DRAFT)
  invoiceNumber String? // số hóa đơn đầu vào
  invoiceUrl    String? // ảnh hóa đơn (Cloudinary)
  paidAt        DateTime?
  note          String?
  createdById   String
  createdBy     User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy       User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  isRecurring      Boolean         @default(false)
  recurringRule    String?
  parentTemplateId String?
  sourceType       String?
  sourceId         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  recurringLogs    RecurringExpenseLog[]

  @@unique([sourceType, sourceId])
  @@index([date])
  @@index([status])
  @@index([projectId])
  @@map("expenses")
}

model RecurringExpenseLog {
  id          String   @id @default(uuid())
  templateId  String
  periodKey   String
  generatedAt DateTime @default(now())
  expenseId   String   @unique
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([templateId, periodKey])
  @@map("recurring_expense_logs")
}

// ==================== PURCHASE ORDERS ====================

enum PurchaseStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  RECEIVED
  PAID
  CANCELLED
}

model PurchaseOrder {
  id             String          @id @default(uuid())
  poCode         String          @unique // PO-YYYYMMDD-XXXX
  date           DateTime        @default(now())
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  status         PurchaseStatus  @default(DRAFT)
  paymentStatus  PaymentStatus   @default(UNPAID)
  subtotal       Decimal         @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(15, 2)
  total          Decimal         @default(0) @db.Decimal(15, 2)
  paidAmount     Decimal         @default(0) @db.Decimal(15, 2)
  receivedAt     DateTime?
  expectedAt     DateTime?
  submittedAt    DateTime?
  note           String?
  invoiceNumber  String?
  createdById    String
  createdBy      User            @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?           @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items PurchaseItem[]
  debt  Debt?

  @@index([status])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(15, 2)
  taxRateId       String?
  taxRate         TaxRate?      @relation(fields: [taxRateId], references: [id])
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  subtotal        Decimal       @db.Decimal(15, 2)

  @@map("purchase_items")
}

// ==================== TAX ====================

model TaxRate {
  id          String   @id @default(uuid())
  code        String   @unique // VAT0, VAT5, VAT8, VAT10
  name        String
  rate        Decimal  @db.Decimal(5, 2) // 0, 5, 8, 10 (%)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses      Expense[]
  purchaseItems PurchaseItem[]

  @@map("tax_rates")
}

// ==================== BANK ACCOUNTS ====================

enum BankTxType {
  DEPOSIT // Nộp tiền
  WITHDRAW // Rút tiền
  TRANSFER_IN // Nhận chuyển khoản
  TRANSFER_OUT // Chuyển khoản đi
  FEE // Phí ngân hàng
  INTEREST // Lãi
}

model BankAccount {
  id             String   @id @default(uuid())
  accountNumber  String   @unique
  bankName       String
  accountName    String
  accountId      String // FK tới Account.id (loại 112)
  openingBalance Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance Decimal  @default(0) @db.Decimal(15, 2)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions BankTransaction[]
  expensesPaid Expense[]         @relation("ExpensePaidFrom")

  @@map("bank_accounts")
}

model BankTransaction {
  id            String      @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime    @default(now())
  type          BankTxType
  amount        Decimal     @db.Decimal(15, 2)
  balanceAfter  Decimal     @db.Decimal(15, 2)
  reference     String? // mã giao dịch ngân hàng
  description   String
  createdById   String?
  createdBy     User?       @relation("BankTxCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([bankAccountId, date])
  @@map("bank_transactions")
}

// ==================== FISCAL PERIOD ====================

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FiscalPeriod {
  id         String             @id @default(uuid())
  year       Int
  month      Int // 1..12; 0 = năm
  startDate  DateTime
  endDate    DateTime
  status     FiscalPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  closedBy   User?              @relation("PeriodClosedBy", fields: [closedById], references: [id])
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  entries JournalEntry[]

  @@unique([year, month])
  @@map("fiscal_periods")
}

// ==================== DEBT ====================

enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  OPEN
  PARTIAL
  CLOSED
  OVERDUE
}

model Debt {
  id         String     @id @default(uuid())
  type       DebtType
  status     DebtStatus @default(OPEN)
  amount     Decimal    @db.Decimal(12, 2)
  paidAmount Decimal    @default(0) @db.Decimal(12, 2)
  dueDate    DateTime?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id])
  orderId    String?   @unique
  order      Order?    @relation(fields: [orderId], references: [id])
  poId       String?   @unique
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])

  payments DebtPayment[]

  @@index([status, dueDate])
  @@map("debts")
}

model DebtPayment {
  id          String        @id @default(uuid())
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  note        String?
  paidAt      DateTime      @default(now())
  debtId      String
  debt        Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@map("debt_payments")
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  ORDER_PENDING_LONG
  PO_PENDING_APPROVAL
  DEBT_OVERDUE
  PAYROLL_DUE
  EXPENSE_PENDING_APPROVAL
  PERIOD_CLOSING_REMINDER
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id         String               @id @default(uuid())
  type       NotificationType
  severity   NotificationSeverity   @default(INFO)
  title      String
  message    String
  link       String?
  meta       Json?
  isRead     Boolean              @default(false)
  createdAt  DateTime             @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleScope Role?

  @@index([userId, isRead])
  @@index([roleScope, isRead])
  @@map("notifications")
}

// ==================== PROJECT MANAGEMENT ====================

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

model Project {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(15, 2)

  createdById String
  createdBy   User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  tasks    ProjectTask[]
  members  ProjectMember[]
  expenses Expense[]       @relation("ProjectExpenses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
  @@map("projects")
}

model ProjectTask {
  id          String              @id @default(uuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      ProjectTaskStatus   @default(TODO)
  priority    ProjectTaskPriority @default(MEDIUM)
  dueDate     DateTime?

  assigneeId String?
  assignee   User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id])

  createdById String
  createdBy   User   @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@map("project_tasks")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("ProjectMemberships", fields: [userId], references: [id])
  role      ProjectMemberRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

// ==================== PRODUCTION MANAGEMENT ====================

enum BomStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Bom {
  id        String    @id @default(uuid())
  code      String    @unique
  productId String
  product   Product   @relation("BomProduct", fields: [productId], references: [id])
  version   String    @default("v1")
  status    BomStatus @default(DRAFT)
  notes     String?

  items      BomItem[]
  workOrders WorkOrder[]

  createdById String
  createdBy   User   @relation("BomCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@map("boms")
}

model BomItem {
  id          String  @id @default(uuid())
  bomId       String
  bom         Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("BomComponent", fields: [componentId], references: [id])
  quantity    Int
  notes       String?

  createdAt DateTime @default(now())

  @@unique([bomId, componentId])
  @@map("bom_items")
}

model WorkOrder {
  id        String  @id @default(uuid())
  code      String  @unique
  bomId     String
  bom       Bom     @relation(fields: [bomId], references: [id])
  productId String
  product   Product @relation("WorkOrderProduct", fields: [productId], references: [id])

  quantity    Int
  producedQty Int @default(0)

  // Tổng giá vốn nguyên liệu tại thời điểm complete (đơn vị: VND)
  totalCost      Decimal? @db.Decimal(15, 2)
  // Tham chiếu tới bút toán kế toán khi complete
  journalEntryId String?

  status WorkOrderStatus @default(DRAFT)

  warehouseId String
  warehouse   Warehouse @relation("WorkOrderWarehouse", fields: [warehouseId], references: [id])

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  notes String?

  items WorkOrderItem[]

  createdById String
  createdBy   User   @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([productId])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  componentId String
  component   Product   @relation("WorkOrderComponent", fields: [componentId], references: [id])

  requiredQty Int
  consumedQty Int @default(0)

  createdAt DateTime @default(now())

  @@unique([workOrderId, componentId])
  @@map("work_order_items")
}
