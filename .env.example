# Server
PORT=3000
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:cc@localhost:5432/erp_db?schema=public"
# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS / Frontend
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10

# Bcrypt
BCRYPT_ROUNDS=10

#tự điền dô như .env nha 
#Cloudinary
CLOUDINARY_CLOUD_NAME=tên_cloud
CLOUDINARY_API_KEY=mã_api_key
CLOUDINARY_API_SECRET=mã_api_secret
#tự điền api key của bây dô đây nha
OPENAI_API_KEY=your-openai-api-key-here

# Company / Invoice
COMPANY_NAME=Mini ERP Store
COMPANY_ADDRESS=123 Đường ABC, Quận 1, TP.HCM
COMPANY_TAX_ID=0123456789
INVOICE_VAT_RATE=10

# Loyalty
LOYALTY_POINTS_PER_1000=1
LOYALTY_REDEEM_POINTS=100
LOYALTY_REDEEM_VALUE=10000

# Delivery webhook (GHTK)
GHTK_WEBHOOK_SECRET=

# Email (invoice)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=